# Copy-binary image used by GoReleaser Pro (dockers_v2).
# Local and fork builds use the repo-root Dockerfile.
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

# ffmpeg (enhanced fork): required to split APE/WV/M4A/WAV CUE albums.
RUN apk add --no-cache ca-certificates openssl tzdata curl jq ffmpeg

ARG TARGETPLATFORM
# Actions zip artifacts store every file as 0644; without --chmod the image
# entrypoint is not executable (OCI permission denied).
COPY --chmod=755 ${TARGETPLATFORM}/unpackerr /unpackerr

ENV TZ=UTC

ENTRYPOINT ["/unpackerr"]
